# ==============================================================================
# Tabbed Pro — Environment Variables Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
# URL of frontend application for CORS origin validation
ALLOWED_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHE
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Compatible with Supabase, Neon, AWS RDS, Railway, Docker Postgres, etc.
DATABASE_URL="postgresql://postgres:password@localhost:5432/tabbed_pro?schema=public"

# Redis Cache URL (used in docker-compose for rate-limiting and session cache)
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key for signing and verifying JSON Web Tokens (JWT) in production
JWT_SECRET="your-super-secret-jwt-signing-key-min-32-chars"

# Optional: Google OAuth 2.0 (Google Cloud Console credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. STRIPE BILLING & SUBSCRIPTIONS
# ------------------------------------------------------------------------------
# Stripe API Secret Key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY="sk_test_yourStripeSecretKey"

# Stripe Webhook Signing Secret (whsec_... from Stripe Dashboard Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_yourStripeWebhookSecret"

# Stripe Recurring Price IDs (created in Stripe Dashboard > Products)
STRIPE_PRO_PRICE_ID="price_tabbed_pro_monthly"
STRIPE_TEAMS_PRICE_ID="price_tabbed_teams_monthly"

# ------------------------------------------------------------------------------
# 5. AI LLM PROVIDERS (Optimization & Evaluation Engine)
# Supply at least one provider key. If omitted, the engine uses mock offline adapter.
# ------------------------------------------------------------------------------
# OpenAI API Key (GPT-4o prompt scoring and SSE streaming)
OPENAI_API_KEY=""

# Anthropic API Key (Claude 3.5 Sonnet prompt evaluation)
ANTHROPIC_API_KEY=""

# Google Gemini API Key (Gemini 1.5 Flash prompt optimization)
GEMINI_API_KEY=""

# Optional: Local / Self-hosted LLM (Ollama / LM Studio / LocalAI)
LOCAL_LLM_URL="http://localhost:11434"
OLLAMA_HOST="http://localhost:11434"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAILS (Optional - for production auth verification)
# ------------------------------------------------------------------------------
# Resend / SendGrid API key for password reset and account verification emails
RESEND_API_KEY=""
EMAIL_FROM="Tabbed <notifications@tabbed.pro>"
